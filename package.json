{
  "name": "confetti-design-system",
  "version": "0.3.0",
  "private": true,
  "description": "Confetti \u2014 personal portfolio design system. Multi-theme, multi-mode token architecture.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "tokens": "npm run audit:tokens && node style-dictionary/build.js",
    "audit:tokens": "node style-dictionary/audit-layers.js",
    "audit:css": "node style-dictionary/audit-css.js",
    "storybook": "npm run tokens && storybook dev",
    "build-storybook": "npm run tokens && storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run audit:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\"",
    "check": "npm run tokens && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "chromatic": "^18.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.21",
    "storybook": "^10.5.7",
    "style-dictionary": "^5.5.0",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
