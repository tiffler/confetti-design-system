{
  "badge": {
    "radius": {
      "value": "{borders.radius.control}"
    },
    "border-width": {
      "value": "{borders.stroke-weight.thin}",
      "comment": "soft pill — 1px hairline, not the 2px sticker edge"
    },
    "border": {
      "value": "{borders.stroke-color.subtle}",
      "comment": "soft pill — subtle tint, not the ink sticker border"
    },
    "font-family": {
      "value": "{font.family.label}"
    },
    "font-size": {
      "value": "{font.size.label}"
    },
    "font-weight": {
      "value": "{font.weight.label}"
    },
    "tracking": {
      "value": "{font.tracking.label}"
    },
    "padding-horizontal": {
      "value": "{space.inset-tight}"
    },
    "padding-vertical": {
      "value": "{space.inset-xs}"
    },
    "text": {
      "value": "{accent.on-bold}"
    },
    "text-subtle": {
      "value": "{accent.on-subtle}"
    },
    "text-neutral": {
      "value": "{text.default}"
    },
    "text-subtle-neutral": {
      "value": "{text.muted}"
    },
    "$comment-success": "Success is the one hue that is not decorative, so — like neutral — it carries its own foregrounds rather than the shared accent ones: its bold end is a deep green holding a white label, the inverse of an accent's light fill holding ink.",
    "text-success": {
      "value": "{status.success.on-fill}"
    },
    "text-subtle-success": {
      "value": "{status.success.on-subtle}"
    },
    "fill": {
      "purple": {
        "value": "{accent.purple.bold}"
      },
      "teal": {
        "value": "{accent.teal.bold}"
      },
      "orange": {
        "value": "{accent.orange.bold}"
      },
      "pink": {
        "value": "{accent.pink.bold}"
      },
      "success": {
        "value": "{status.success.fill}"
      },
      "neutral": {
        "value": "{surface.raised}",
        "comment": "paper fill — a badge that isn't a category"
      }
    },
    "fill-subtle": {
      "purple": {
        "value": "{accent.purple.subtle}"
      },
      "teal": {
        "value": "{accent.teal.subtle}"
      },
      "orange": {
        "value": "{accent.orange.subtle}"
      },
      "pink": {
        "value": "{accent.pink.subtle}"
      },
      "success": {
        "value": "{status.success.subtle}"
      }
    }
  }
}
